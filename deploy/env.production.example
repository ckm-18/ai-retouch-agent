# 服务器生产环境配置模板
# 用法（在服务器项目根目录）：
#   cp deploy/env.production.example .env
#   sed -i "s/CHANGE_ME_JWT/$(openssl rand -hex 32)/" .env
#   sed -i "s/YOUR_SERVER_IP/你的服务器公网IP/" .env
# 然后填入 DASHSCOPE_API_KEY（或保持 mock 零成本运行）

APP_ENV=production
API_PORT=7302

# DATABASE_URL / REDIS_URL / S3_ENDPOINT 无需修改：
# docker-compose 的 environment 会把它们覆盖为容器内网地址
DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@localhost:7311/retouch
REDIS_URL=redis://localhost:7312
S3_ENDPOINT=http://localhost:7313

# 浏览器加载图片用的公网地址，必须改成服务器公网 IP（或域名）
S3_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:7313
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
S3_URL_TTL=900

# 生产环境必须是随机字符串（按上方 sed 命令自动生成，切勿保留此占位值）
JWT_SECRET=CHANGE_ME_JWT
JWT_TTL_HOURS=24

# 真实模型：dashscope + Key；纯演示可改 mock
IMAGE_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
IMAGE_EDIT_MODEL=qwen-image-edit-max
PLANNER_MODEL=qwen-plus
MATTING_PROVIDER=auto
OCR_PROVIDER=auto
